{
  "name": "repotwin",
  "version": "0.3.0",
  "description": "Experimental optimization and diagnostic platform for Git repositories and AI coding agents",
  "type": "module",
  "bin": {
    "repotwin": "dist/index.js"
  },
  "scripts": {
    "build": "npm run build:server && npm run typecheck:studio && npm run build:studio",
    "typecheck:studio": "tsc --noEmit -p studio/tsconfig.json",
    "build:server": "tsc",
    "build:studio": "vite build --config studio/vite.config.ts",
    "dev": "npm run build:studio && tsx src/index.ts",
    "pretest": "npm run build:studio",
    "test": "vitest run --no-cache --test-timeout 20000",
    "test:watch": "vitest",
    "prepack": "npm run build",
    "setup-mcp": "node dist/index.js setup-mcp"
  },
  "files": [
    "dist",
    "README.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "ai-agents",
    "git",
    "repository-optimization",
    "claude-code",
    "cursor",
    "benchmark"
  ],
  "author": "Heykel Mannai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heykelm/repotwin.git"
  },
  "bugs": {
    "url": "https://github.com/heykelm/repotwin/issues"
  },
  "homepage": "https://github.com/heykelm/repotwin#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "chalk": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "^12.1.0",
    "lucide-react": "^1.61.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.8.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
