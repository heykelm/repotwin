{
  "$schema": "https://json.schemastore.org/mcp-settings.json",
  "description": "Ready-to-use RepoTwin MCP configuration across all major AI coding assistants and IDEs.",
  "configurations": {
    "cursor": {
      "targetFile": "~/.cursor/mcp.json (or .cursor/mcp.json in workspace)",
      "content": {
        "mcpServers": {
          "repotwin": {
            "command": "repotwin",
            "args": ["mcp"]
          }
        }
      }
    },
    "claudeDesktop": {
      "targetFile": "~/Library/Application Support/Claude/claude_desktop_config.json (macOS) or %APPDATA%\\Claude\\claude_desktop_config.json (Windows)",
      "content": {
        "mcpServers": {
          "repotwin": {
            "command": "repotwin",
            "args": ["mcp"]
          }
        }
      }
    },
    "claudeCode": {
      "targetFile": "~/.claude.json or .mcp.json (in project root)",
      "content": {
        "mcpServers": {
          "repotwin": {
            "command": "repotwin",
            "args": ["mcp"]
          }
        }
      }
    },
    "geminiAntigravity": {
      "targetFile": "~/.gemini/antigravity-ide/mcp_config.json",
      "content": {
        "mcpServers": {
          "repotwin": {
            "command": "repotwin",
            "args": ["mcp"]
          }
        }
      }
    },
    "windsurf": {
      "targetFile": "~/.codeium/windsurf/mcp_config.json",
      "content": {
        "mcpServers": {
          "repotwin": {
            "command": "repotwin",
            "args": ["mcp"]
          }
        }
      }
    },
    "vscodeClineRooCode": {
      "targetFile": "~/Library/Application Support/Code/User/globalStorage/saoudrizwan.claude-dev/settings/cline_mcp_settings.json",
      "content": {
        "mcpServers": {
          "repotwin": {
            "command": "repotwin",
            "args": ["mcp"]
          }
        }
      }
    }
  },
  "oneClickSetupCommand": "./scripts/setup-mcp.sh all"
}

